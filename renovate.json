{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "none",
  "branchTopic": "{{{depNameSanitized}}}-{{{newVersion}}}",
  "pruneStaleBranches": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"],
    "recreateWhen": "never"
  },
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Renovate version pinned in the workflows",
      "managerFilePatterns": [".github/workflows/*.yml"],
      "matchStrings": ["renovate-version: \"?(?<currentValue>[^\"\\s]+)\"?"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/renovatebot/renovate"
    },
    {
      "customType": "regex",
      "description": "Track the Python version pinned in the workflows",
      "managerFilePatterns": [".github/workflows/*.yml"],
      "matchStrings": ["python-version: \"?(?<currentValue>[^\"\\s]+)\"?"],
      "datasourceTemplate": "python-version",
      "depNameTemplate": "python"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "automerge": false,
      "groupName": "nix flake inputs"
    }
  ]
}
