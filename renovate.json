{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "3 days",
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "automerge": false,
      "groupName": "nix flake inputs"
    }
  ],
  "schedule": ["before 9am every day"]
}
