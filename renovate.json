{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "none",
  "branchTopic": "{{{depNameSanitized}}}-{{{newVersion}}}",
  "pruneStaleBranches": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Renovate version pinned in the Renovate workflow",
      "managerFilePatterns": [".github/workflows/renovate.yml"],
      "matchStrings": ["renovate-version: (?<currentValue>\\S+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/renovatebot/renovate"
    },
    {
      "customType": "regex",
      "description": "Track the Orca release pinned in the Orca app module",
      "managerFilePatterns": ["home-manager/common/apps/orca/default.nix"],
      "matchStrings": ["version = \"(?<currentValue>[^\"]+)\";"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "stablyai/orca",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "automerge": false,
      "groupName": "nix flake inputs"
    },
    {
      "matchDepNames": ["stablyai/orca"],
      "postUpgradeTasks": {
        "commands": ["bash .github/renovate/update-orca-hashes.sh"],
        "fileFilters": ["home-manager/common/apps/orca/default.nix"],
        "executionMode": "update"
      }
    }
  ]
}
