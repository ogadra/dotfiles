{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "branchTopic": "{{{depNameSanitized}}}-{{{newVersion}}}",
  "pruneStaleBranches": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"],
    "recreateWhen": "never"
  },
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Renovate version pinned in the workflows",
      "managerFilePatterns": [".github/workflows/*.yml"],
      "matchStrings": ["renovate-version: \"?(?<currentValue>[^\"\\s]+)\"?"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/renovatebot/renovate"
    },
    {
      "customType": "regex",
      "description": "Track the Python version pinned in the workflows",
      "managerFilePatterns": [".github/workflows/*.yml"],
      "matchStrings": ["python-version: \"?(?<currentValue>[^\"\\s]+)\"?"],
      "datasourceTemplate": "python-version",
      "depNameTemplate": "python"
    },
    {
      "customType": "regex",
      "description": "Track the devin-cli version in the copy of its manifest",
      "managerFilePatterns": ["home-manager/common/cli/devin/manifest.json"],
      "matchStrings": ["\"version\": \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "custom.devin-cli",
      "depNameTemplate": "devin-cli"
    }
  ],
  "customDatasources": {
    "devin-cli": {
      "defaultRegistryUrlTemplate": "https://static.devin.ai/cli/current/manifest.json",
      "transformTemplates": ["{\"releases\": [{\"version\": version}]}"]
    }
  },
  "packageRules": [
    {
      "matchDatasources": ["custom.devin-cli"],
      "postUpgradeTasks": {
        "commands": ["node home-manager/common/cli/devin/update-manifest.mjs"],
        "fileFilters": ["home-manager/common/cli/devin/manifest.json"],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": ["nix"],
      "automerge": false,
      "groupName": "nix flake inputs"
    },
    {
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "commitMessageTopic": "flake.lock"
    },
    {
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "commitMessageTopic": "uv.lock"
    }
  ]
}
