{ ... }:
{
  system.defaults.menuExtraClock = {
    # 24-hour time
    Show24Hour = true;

    # Show seconds
    ShowSeconds = true;

    # Show the day of the week
    ShowDayOfWeek = true;

    # Keep the clock digital
    IsAnalog = false;

    # Date: 0=when there is room, 1=always, 2=never
    ShowDate = 1;
  };
}
