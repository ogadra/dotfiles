diff --git a/src/client/shell/sidebar_tabs.rs b/src/client/shell/sidebar_tabs.rs
new file mode 100644
index 00000000..cd2827c3
--- /dev/null
+++ b/src/client/shell/sidebar_tabs.rs
@@ -0,0 +1,238 @@
+use super::*;
+
+/// Rule row plus the " tabs" title row.
+const TAB_LIST_HEADER_ROWS: u16 = 2;
+
+/// Name row plus path row for each tab.
+const TAB_ROWS: u16 = 2;
+
+/// Whether this frame lists the tabs in the sidebar instead of on the horizontal row.
+/// A collapsed sidebar has no room for names and the machines sidebar has no tabs section, so
+/// both keep the horizontal row rather than leaving the tabs unreachable.
+pub(super) fn sidebar_lists_tabs(
+    layout: ClientShellLayout,
+    config: &ClientShellConfig,
+    state: &ShellRenderState<'_>,
+) -> bool {
+    config.tab_bar_position == TabBarPositionConfig::Sidebar
+        && layout.sidebar.width > 0
+        && !state.sidebar_collapsed
+        && state.endpoints.len() <= 1
+}
+
+/// Sizes the spaces section to its rows, so a few spaces leave the rest to the tabs and agents.
+/// The dragged split still caps it, because a long spaces list would otherwise push both out.
+pub(super) fn content_sized_split(total_height: u16, spaces_rows: u16, split: f32) -> f32 {
+    if total_height == 0 {
+        return split;
+    }
+    split.min(f32::from(spaces_rows) / f32::from(total_height))
+}
+
+/// Rule, title, and spacer rows above the agent list, matching `render_agent_list`.
+const AGENT_PANEL_HEADER_ROWS: u16 = 3;
+
+/// Splits the detail area into the tab list on top and the agents pinned to the bottom. The
+/// agents list every space's agents, so sizing them to their rows keeps them in place while the
+/// tab list, which follows the focused space, changes length; they take at most half the area.
+pub(super) fn split_tab_list_area(
+    area: Rect,
+    snapshot: &ClientShellSnapshot,
+    config: &ClientShellConfig,
+) -> (Rect, Rect) {
+    let agents = super::agent_sidebar::agent_rows(snapshot, config, None);
+    let agent_rows =
+        agents
+            .iter()
+            .enumerate()
+            .fold(AGENT_PANEL_HEADER_ROWS, |rows, (index, agent)| {
+                let gap = if index + 1 < agents.len() {
+                    config.agents.row_gap
+                } else {
+                    0
+                };
+                rows.saturating_add(agent.rows.len().max(1).min(u16::MAX as usize) as u16)
+                    .saturating_add(gap)
+            });
+    // The tab list is reserved for the space with the most tabs rather than the focused one, so
+    // switching spaces leaves the agents in place while they still take any room tabs never use
+    let busiest_space_tabs = snapshot
+        .workspaces
+        .iter()
+        .map(|workspace| {
+            snapshot
+                .tabs
+                .iter()
+                .filter(|tab| tab.workspace_id == workspace.workspace_id)
+                .count()
+        })
+        .max()
+        .unwrap_or(0);
+    let tab_rows = if busiest_space_tabs == 0
+        || (config.hide_tab_bar_when_single_tab && busiest_space_tabs == 1)
+    {
+        0
+    } else {
+        TAB_LIST_HEADER_ROWS.saturating_add(
+            (busiest_space_tabs.min(u16::MAX as usize) as u16).saturating_mul(TAB_ROWS),
+        )
+    };
+    // One row past the list keeps the last agent off the collapse toggle in the bottom corner;
+    // agents always keep half the area, so a space with many tabs cannot squeeze them out
+    let agent_room = area.height.saturating_sub(tab_rows).max(area.height / 2);
+    let agent_height = agent_rows.saturating_add(1).min(agent_room);
+    let tab_height = area.height.saturating_sub(agent_height);
+    let agent_area = Rect {
+        y: area.y.saturating_add(tab_height),
+        height: agent_height,
+        ..area
+    };
+    let tab_count = focused_workspace_tabs(snapshot).count();
+    if tab_count == 0 || (config.hide_tab_bar_when_single_tab && tab_count == 1) {
+        return (Rect::default(), agent_area);
+    }
+    (
+        Rect {
+            height: tab_height,
+            ..area
+        },
+        agent_area,
+    )
+}
+
+pub(super) fn render_tab_list(
+    buffer: &mut Buffer,
+    area: Rect,
+    snapshot: &ClientShellSnapshot,
+    config: &ClientShellConfig,
+    hits: &mut ShellHitMap,
+) {
+    let palette = &config.palette;
+    if area.height <= TAB_LIST_HEADER_ROWS {
+        return;
+    }
+    put_text(
+        buffer,
+        area.x,
+        area.y,
+        area.width,
+        &"─".repeat(area.width as usize),
+        Style::default().fg(palette.surface_dim),
+    );
+    put_text(
+        buffer,
+        area.x,
+        area.y + 1,
+        area.width,
+        " tabs",
+        Style::default()
+            .fg(palette.overlay0)
+            .add_modifier(Modifier::BOLD),
+    );
+    let body = Rect::new(
+        area.x,
+        area.y + TAB_LIST_HEADER_ROWS,
+        area.width,
+        area.height - TAB_LIST_HEADER_ROWS,
+    );
+    hits.tab_list = body;
+
+    let tabs = focused_workspace_tabs(snapshot).collect::<Vec<_>>();
+    // Scroll only as far as needed to keep the focused tab on screen; the wheel already moves
+    // between tabs, so a separate list offset would only fight it.
+    let visible = (body.height / TAB_ROWS).max(1) as usize;
+    let first = tabs
+        .iter()
+        .position(|tab| tab.focused)
+        .map_or(0, |focused| (focused + 1).saturating_sub(visible));
+    for (row, tab) in tabs.iter().skip(first).take(visible).enumerate() {
+        let rect = Rect::new(
+            body.x,
+            body.y + row as u16 * TAB_ROWS,
+            body.width,
+            TAB_ROWS.min(body.height),
+        );
+        render_tab_row(buffer, rect, tab, config);
+        if rect.height > 1 {
+            super::agent_sidebar::put_key_hint(
+                buffer,
+                rect.x + 1,
+                rect.y + 1,
+                &config.keybinds.keybinds.switch_tab,
+                first + row,
+                config,
+            );
+        }
+        hits.tabs.push((rect, tab.tab_id.clone()));
+    }
+}
+
+fn render_tab_row(
+    buffer: &mut Buffer,
+    rect: Rect,
+    tab: &ClientShellTab,
+    config: &ClientShellConfig,
+) {
+    let palette = &config.palette;
+    if tab.focused {
+        buffer.set_style(rect, Style::default().bg(palette.active_row_bg));
+    }
+    // A tab in ssh takes the red name whether focused or not, so a remote shell stands out
+    // from local ones at a glance
+    let name_style = if tab.ssh {
+        let style = Style::default().fg(palette.red);
+        if tab.focused {
+            style.add_modifier(Modifier::BOLD)
+        } else {
+            style
+        }
+    } else if tab.focused {
+        Style::default()
+            .fg(palette.text)
+            .add_modifier(Modifier::BOLD)
+    } else if tab.custom_label {
+        Style::default().fg(palette.subtext0)
+    } else {
+        Style::default().fg(palette.overlay0)
+    };
+    let right = rect.right();
+    let x = put_segment(buffer, rect.x, rect.y, right, " ", Style::default());
+    let x = put_segment(
+        buffer,
+        x,
+        rect.y,
+        right,
+        status_icon(tab.agent_status, config.status_indicators),
+        Style::default().fg(status_color(tab.agent_status, palette)),
+    );
+    // An auto-named tab is only its number, so the shell's title (the running or last command)
+    // says more; a name the user or an agent gave the tab is kept as is.
+    let name = match (&tab.title, tab.custom_label) {
+        (Some(title), false) => title.as_str(),
+        _ => tab.label.as_str(),
+    };
+    let label = if tab.zoomed {
+        format!(" {name} Z")
+    } else {
+        format!(" {name}")
+    };
+    let name_x = x;
+    put_segment(buffer, x, rect.y, right, &label, name_style);
+    if let Some(path) = tab.path.as_deref().filter(|_| rect.height > 1) {
+        put_segment(
+            buffer,
+            name_x,
+            rect.y + 1,
+            right,
+            &format!(" {path}"),
+            Style::default().fg(palette.subtext0),
+        );
+    }
+}
+
+fn focused_workspace_tabs(snapshot: &ClientShellSnapshot) -> impl Iterator<Item = &ClientShellTab> {
+    snapshot
+        .tabs
+        .iter()
+        .filter(|tab| Some(tab.workspace_id.as_str()) == snapshot.focused_workspace_id.as_deref())
+}
