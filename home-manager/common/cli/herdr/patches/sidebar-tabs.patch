@@ -0,0 +1,316 @@
+use super::*;
+
+fn sidebar_tabs_state(tab_count: usize, focused: usize) -> ClientShellState {
+    let mut projected = snapshot();
+    projected.tab_bar_right = vec![crate::protocol::ClientShellTabStatusSegment {
+        text: "host".into(),
+        accent: false,
+    }];
+    projected.tabs.clear();
+    for number in 1..=tab_count {
+        projected.tabs.push(ClientShellTab {
+            tab_id: format!("tab_{number}"),
+            workspace_id: "ws_1".into(),
+            number,
+            label: format!("name{number}"),
+            custom_label: true,
+            zoomed: false,
+            focused: number == focused,
+            agent_status: AgentStatus::Idle,
+            title: None,
+            path: None,
+            ssh: false,
+        });
+    }
+    projected.focused_tab_id = Some(format!("tab_{focused}"));
+    let mut config = ClientShellConfig::from_config(&Config::default());
+    config.mobile_width_threshold = 0;
+    config.tab_bar_position = crate::config::TabBarPositionConfig::Sidebar;
+    let mut state = ClientShellState::new(config);
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state
+}
+
+fn click(state: &mut ClientShellState, kind: MouseEventKind, rect: Rect) -> ClientShellInput {
+    state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind,
+        column: rect.x + 1,
+        row: rect.y,
+        modifiers: KeyModifiers::empty(),
+    })])
+}
+
+#[test]
+fn sidebar_position_lists_tabs_in_sidebar_and_keeps_status_on_top_row() {
+    let mut state = sidebar_tabs_state(3, 2);
+    let frame = state.compose(106, 30).expect("sidebar tabs");
+    let layout = state.layout(106, 30);
+    let rows = frame_rows(&frame);
+
+    assert!(!state.hits.tab_list.is_empty());
+    assert_eq!(state.hits.tabs.len(), 3);
+    assert!(state
+        .hits
+        .tabs
+        .iter()
+        .all(|(rect, _)| rect.right() <= layout.sidebar.right() && rect.y > 0));
+    assert!(rows.iter().any(|row| row.contains(" tabs")));
+    let top = &rows[layout.tab_bar.y as usize];
+    assert!(top.ends_with("host"));
+    assert!(!top.contains("name1"));
+    let (column, row) = cell_symbol_position(&frame, layout.sidebar, "name2");
+    let buffer = frame.to_ratatui_buffer().expect("sidebar tabs buffer");
+    let focused = buffer.cell((column, row)).expect("focused tab cell");
+    assert_eq!(focused.bg, state.config.palette.active_row_bg);
+}
+
+#[test]
+fn collapsed_sidebar_falls_back_to_the_tab_row() {
+    let mut state = sidebar_tabs_state(3, 1);
+    state.sidebar_collapsed = true;
+    state.compose(106, 30).expect("collapsed sidebar");
+    let layout = state.layout(106, 30);
+
+    assert!(state.hits.tab_list.is_empty());
+    assert_eq!(state.hits.tabs.len(), 3);
+    assert!(state
+        .hits
+        .tabs
+        .iter()
+        .all(|(rect, _)| rect.y == layout.tab_bar.y));
+}
+
+#[test]
+fn sidebar_tab_click_focuses_and_dragging_does_not_reorder() {
+    let mut state = sidebar_tabs_state(3, 1);
+    state.compose(106, 30).expect("sidebar tabs");
+    let first = state.hits.tabs[0].0;
+    let third = state.hits.tabs[2].0;
+
+    click(&mut state, MouseEventKind::Down(MouseButton::Left), third);
+    click(&mut state, MouseEventKind::Drag(MouseButton::Left), first);
+    assert!(state.chrome_drag.is_none());
+    let release = click(&mut state, MouseEventKind::Up(MouseButton::Left), first);
+
+    assert!(matches!(
+        &release.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::TabFocus(target) if target.tab_id == "tab_3")
+    ));
+}
+
+#[test]
+fn sidebar_tab_list_keeps_the_focused_tab_visible() {
+    let mut state = sidebar_tabs_state(30, 30);
+    state.compose(106, 30).expect("many sidebar tabs");
+
+    assert!(state.hits.tabs.len() < 30);
+    assert_eq!(
+        state.hits.tabs.last().map(|(_, tab_id)| tab_id.as_str()),
+        Some("tab_30")
+    );
+}
+
+#[test]
+fn single_tab_hides_the_sidebar_list_when_configured() {
+    let mut state = sidebar_tabs_state(1, 1);
+    state.config.hide_tab_bar_when_single_tab = true;
+    state.compose(106, 30).expect("single tab");
+
+    assert!(state.hits.tab_list.is_empty());
+    assert!(state.hits.tabs.is_empty());
+}
+
+#[test]
+fn auto_named_tab_shows_its_terminal_title_over_the_path() {
+    let mut state = sidebar_tabs_state(2, 1);
+    let snapshot = state.snapshot.as_mut().expect("snapshot");
+    snapshot.tabs[0].custom_label = false;
+    snapshot.tabs[0].title = Some("cargo test".into());
+    snapshot.tabs[0].path = Some("herdr/src".into());
+    snapshot.tabs[1].title = Some("vim".into());
+    let frame = state.compose(106, 30).expect("titled tabs");
+    let rows = frame_rows(&frame);
+
+    let (_, title_row) = cell_symbol_position(&frame, state.layout(106, 30).sidebar, "cargo test");
+    assert!(rows[title_row as usize + 1].contains("herdr/src"));
+    assert!(rows.iter().any(|row| row.contains("name2")));
+    assert!(!rows.iter().any(|row| row.contains("vim")));
+    assert_eq!(state.hits.tabs[0].0.height, 2);
+}
+
+#[test]
+fn spaces_section_shrinks_to_its_rows() {
+    let mut state = sidebar_tabs_state(2, 1);
+    state.compose(106, 30).expect("sidebar tabs");
+    let sidebar = state.layout(106, 30).sidebar;
+
+    assert!(state.hits.sidebar_section_divider.y < sidebar.y + sidebar.height / 2);
+    assert!(state.hits.tab_list.y < sidebar.y + sidebar.height / 2);
+}
+
+#[test]
+fn agents_stay_pinned_to_the_bottom_when_the_tab_count_changes() {
+    let mut few = sidebar_tabs_state(1, 1);
+    few.compose(106, 30).expect("one tab");
+    let mut many = sidebar_tabs_state(5, 1);
+    many.compose(106, 30).expect("five tabs");
+
+    assert_eq!(few.hits.agent_body, many.hits.agent_body);
+    assert!(many.hits.tab_list.bottom() <= many.hits.agent_body.y);
+}
+
+#[test]
+fn space_colors_paint_each_space_and_its_agents() {
+    let mut state = sidebar_tabs_state(1, 1);
+    let snapshot = state.snapshot.as_mut().expect("snapshot");
+    let mut second = snapshot.workspaces[0].clone();
+    second.workspace_id = "ws_2".into();
+    second.label = "other".into();
+    second.focused = false;
+    snapshot.workspaces.push(second);
+    snapshot.agents = vec![ClientShellAgent {
+        pane_id: "pane_1".into(),
+        workspace_id: "ws_2".into(),
+        tab_id: "tab_1".into(),
+        name: Some("claude".into()),
+        display_agent: None,
+        agent: None,
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status: AgentStatus::Idle,
+        state_change_seq: 1,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused: false,
+    }];
+    state.config.spaces.colors = vec!["#112233".into(), "#445566".into()];
+    let frame = state.compose(106, 30).expect("colored spaces");
+    let buffer = frame.to_ratatui_buffer().expect("colored buffer");
+    let sidebar = state.layout(106, 30).sidebar;
+    let bg_at = |needle: &str| {
+        let (column, row) = cell_symbol_position(&frame, sidebar, needle);
+        buffer.cell((column, row)).expect("cell").bg
+    };
+
+    let second_space = crate::config::parse_color("#445566");
+    assert_eq!(bg_at("other"), second_space);
+    assert_eq!(bg_at("claude"), second_space);
+    // The focused space brightens its color; the others keep theirs
+    assert_eq!(
+        bg_at("client-shell"),
+        ratatui::style::Color::Rgb(30, 61, 91)
+    );
+}
+
+#[test]
+fn agents_take_the_rows_the_tab_list_never_needs() {
+    let mut state = sidebar_tabs_state(1, 1);
+    let snapshot = state.snapshot.as_mut().expect("snapshot");
+    snapshot.agents = (1..=20)
+        .map(|number| ClientShellAgent {
+            pane_id: format!("pane_{number}"),
+            workspace_id: "ws_1".into(),
+            tab_id: "tab_1".into(),
+            name: Some(format!("agent{number}")),
+            display_agent: None,
+            agent: None,
+            title: None,
+            terminal_title: None,
+            terminal_title_stripped: None,
+            agent_status: AgentStatus::Idle,
+            state_change_seq: number,
+            state_labels: Vec::new(),
+            tokens: Vec::new(),
+            focused: number == 1,
+        })
+        .collect();
+    state.compose(106, 40).expect("many agents");
+    let sidebar = state.layout(106, 40).sidebar;
+    let detail_top = state.hits.tab_list.y;
+    let detail_height = sidebar.bottom() - detail_top;
+
+    assert!(state.hits.agent_body.height > detail_height / 2);
+    assert!(state.hits.tab_list.height >= 2);
+}
+
+#[test]
+fn only_the_focused_agent_is_bold() {
+    let mut state = sidebar_tabs_state(1, 1);
+    let snapshot = state.snapshot.as_mut().expect("snapshot");
+    snapshot.agents = ["active", "other"]
+        .into_iter()
+        .enumerate()
+        .map(|(index, name)| ClientShellAgent {
+            pane_id: format!("pane_{index}"),
+            workspace_id: "ws_1".into(),
+            tab_id: "tab_1".into(),
+            name: Some(name.into()),
+            display_agent: None,
+            agent: None,
+            title: None,
+            terminal_title: None,
+            terminal_title_stripped: None,
+            agent_status: AgentStatus::Idle,
+            state_change_seq: index as u64,
+            state_labels: Vec::new(),
+            tokens: Vec::new(),
+            focused: index == 0,
+        })
+        .collect();
+    state.config.agents.rows = vec![vec![crate::config::AgentSidebarToken::Agent]];
+    let frame = state.compose(106, 30).expect("agents");
+    let buffer = frame.to_ratatui_buffer().expect("agents buffer");
+    let sidebar = state.layout(106, 30).sidebar;
+    let bold_at = |needle: &str| {
+        let (column, row) = cell_symbol_position(&frame, sidebar, needle);
+        buffer
+            .cell((column, row))
+            .expect("cell")
+            .modifier
+            .contains(ratatui::style::Modifier::BOLD)
+    };
+
+    assert!(bold_at("active"));
+    assert!(!bold_at("other"));
+}
+
+#[test]
+fn tab_running_ssh_names_itself_in_red() {
+    let mut state = sidebar_tabs_state(3, 2);
+    let mut projected = state.snapshot.as_deref().expect("snapshot").clone();
+    for tab in &mut projected.tabs {
+        tab.ssh = tab.number != 3;
+    }
+    state.set_snapshot(Box::new(projected));
+    let frame = state.compose(106, 30).expect("sidebar tabs");
+    let layout = state.layout(106, 30);
+    let buffer = frame.to_ratatui_buffer().expect("sidebar tabs buffer");
+    let fg = |name: &str| {
+        let (column, row) = cell_symbol_position(&frame, layout.sidebar, name);
+        buffer.cell((column, row)).expect("tab name cell").fg
+    };
+
+    assert_eq!(fg("name1"), state.config.palette.red);
+    assert_eq!(fg("name2"), state.config.palette.red);
+    assert_ne!(fg("name3"), state.config.palette.red);
+}
+
+#[test]
+fn status_text_turns_red_while_the_viewed_tab_runs_ssh() {
+    let mut state = sidebar_tabs_state(2, 1);
+    let mut projected = state.snapshot.as_deref().expect("snapshot").clone();
+    projected.tabs[0].ssh = true;
+    state.set_snapshot(Box::new(projected));
+    let frame = state.compose(106, 30).expect("sidebar tabs");
+    let layout = state.layout(106, 30);
+    let buffer = frame.to_ratatui_buffer().expect("sidebar tabs buffer");
+    let (column, row) = cell_symbol_position(&frame, layout.tab_bar, "host");
+
+    assert_eq!(
+        buffer.cell((column, row)).expect("status cell").fg,
+        state.config.palette.red
+    );
+}
