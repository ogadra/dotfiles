+pub(super) fn focused_row_color(color: ratatui::style::Color) -> ratatui::style::Color {
+    match color {
+        ratatui::style::Color::Rgb(red, green, blue) => {
+            let brighten = |channel: u8| (u16::from(channel) * 9 / 5).min(255) as u8;
+            ratatui::style::Color::Rgb(brighten(red), brighten(green), brighten(blue))
+        }
+        other => other,
+    }
+}
