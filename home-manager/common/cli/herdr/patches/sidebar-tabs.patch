+use super::*;
+
+fn sidebar_tabs_state(tab_count: usize, focused: usize) -> ClientShellState {
+    let mut projected = snapshot();
+    projected.tab_bar_right = vec![crate::protocol::ClientShellTabStatusSegment {
+        text: "host".into(),
+        accent: false,
+    }];
+    projected.tabs.clear();
+    for number in 1..=tab_count {
+        projected.tabs.push(ClientShellTab {
+            tab_id: format!("tab_{number}"),
+            workspace_id: "ws_1".into(),
+            number,
+            label: format!("name{number}"),
+            custom_label: true,
+            zoomed: false,
+            focused: number == focused,
+            agent_status: AgentStatus::Idle,
+        });
+    }
+    projected.focused_tab_id = Some(format!("tab_{focused}"));
+    let mut config = ClientShellConfig::from_config(&Config::default());
+    config.mobile_width_threshold = 0;
+    config.tab_bar_position = crate::config::TabBarPositionConfig::Sidebar;
+    let mut state = ClientShellState::new(config);
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state
+}
+
+fn click(state: &mut ClientShellState, kind: MouseEventKind, rect: Rect) -> ClientShellInput {
+    state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind,
+        column: rect.x + 1,
+        row: rect.y,
+        modifiers: KeyModifiers::empty(),
+    })])
+}
+
+#[test]
+fn sidebar_position_lists_tabs_in_sidebar_and_keeps_status_on_top_row() {
+    let mut state = sidebar_tabs_state(3, 2);
+    let frame = state.compose(106, 30).expect("sidebar tabs");
+    let layout = state.layout(106, 30);
+    let rows = frame_rows(&frame);
+
+    assert!(!state.hits.tab_list.is_empty());
+    assert_eq!(state.hits.tabs.len(), 3);
+    assert!(state
+        .hits
+        .tabs
+        .iter()
+        .all(|(rect, _)| rect.right() <= layout.sidebar.right() && rect.y > 0));
+    assert!(rows.iter().any(|row| row.contains(" tabs")));
+    let top = &rows[layout.tab_bar.y as usize];
+    assert!(top.ends_with("host"));
+    assert!(!top.contains("name1"));
+    let (column, row) = cell_symbol_position(&frame, layout.sidebar, "name2");
+    let buffer = frame.to_ratatui_buffer().expect("sidebar tabs buffer");
+    let focused = buffer.cell((column, row)).expect("focused tab cell");
+    assert_eq!(focused.bg, state.config.palette.active_row_bg);
+}
+
+#[test]
+fn collapsed_sidebar_falls_back_to_the_tab_row() {
+    let mut state = sidebar_tabs_state(3, 1);
+    state.sidebar_collapsed = true;
+    state.compose(106, 30).expect("collapsed sidebar");
+    let layout = state.layout(106, 30);
+
+    assert!(state.hits.tab_list.is_empty());
+    assert_eq!(state.hits.tabs.len(), 3);
+    assert!(state
+        .hits
+        .tabs
+        .iter()
+        .all(|(rect, _)| rect.y == layout.tab_bar.y));
+}
+
+#[test]
+fn sidebar_tab_click_focuses_and_dragging_does_not_reorder() {
+    let mut state = sidebar_tabs_state(3, 1);
+    state.compose(106, 30).expect("sidebar tabs");
+    let first = state.hits.tabs[0].0;
+    let third = state.hits.tabs[2].0;
+
+    click(&mut state, MouseEventKind::Down(MouseButton::Left), third);
+    click(&mut state, MouseEventKind::Drag(MouseButton::Left), first);
+    assert!(state.chrome_drag.is_none());
+    let release = click(&mut state, MouseEventKind::Up(MouseButton::Left), first);
+
+    assert!(matches!(
+        &release.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::TabFocus(target) if target.tab_id == "tab_3")
+    ));
+}
+
+#[test]
+fn sidebar_tab_list_keeps_the_focused_tab_visible() {
+    let mut state = sidebar_tabs_state(30, 30);
+    state.compose(106, 30).expect("many sidebar tabs");
+
+    assert!(state.hits.tabs.len() < 30);
+    assert_eq!(
+        state.hits.tabs.last().map(|(_, tab_id)| tab_id.as_str()),
+        Some("tab_30")
+    );
+}
+
+#[test]
+fn single_tab_hides_the_sidebar_list_when_configured() {
+    let mut state = sidebar_tabs_state(1, 1);
+    state.config.hide_tab_bar_when_single_tab = true;
+    state.compose(106, 30).expect("single tab");
+
+    assert!(state.hits.tab_list.is_empty());
+    assert!(state.hits.tabs.is_empty());
+}
