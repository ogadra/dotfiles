+pub(super) fn put_key_hint(
+    buffer: &mut Buffer,
+    x: u16,
+    y: u16,
+    bindings: &[crate::config::IndexedKeybind],
+    index: usize,
+    config: &ClientShellConfig,
+) {
+    let Some(binding) = bindings
+        .iter()
+        .filter(|binding| binding.index == index)
+        .min_by_key(|binding| !binding.trigger.is_direct())
+    else {
+        return;
+    };
+    let key = binding.label.rsplit('+').next().unwrap_or(&binding.label);
+    put_text(
+        buffer,
+        x,
+        y,
+        display_width(key) as u16,
+        key,
+        Style::default().fg(config.palette.overlay0),
+    );
+}
