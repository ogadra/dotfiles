+
+    /// Pid of the ssh process the pane runs in the foreground. Only the group leader is read,
+    /// since the shell makes ssh the leader of the job it runs.
+    pub fn foreground_ssh_pid_for_pane(
+        &self,
+        pane_id: PaneId,
+        terminal_runtimes: &TerminalRuntimeRegistry,
+    ) -> Option<u32> {
+        let terminal_id = self.terminal_id(pane_id)?;
+        let job = terminal_runtimes
+            .get(terminal_id)
+            .and_then(|rt| rt.child_pid())
+            .and_then(crate::detect::foreground_process_group_id)
+            .and_then(crate::detect::foreground_group_leader_job)?;
+        job.processes
+            .iter()
+            .find(|process| process.name == "ssh")
+            .map(|process| process.pid)
+    }
 }
