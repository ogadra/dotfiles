+/// Publishes the ssh state as the herdr_ssh user var (OSC 1337 SetUserVar), so the host
+/// terminal can restyle itself; the value is base64 of "1" or "0", fixed so no encoder is needed.
+pub(crate) fn write_ssh_user_var<W: Write>(writer: &mut W, ssh: bool) -> io::Result<()> {
+    let value = if ssh { "MQ==" } else { "MA==" };
+    write!(writer, "\x1b]1337;SetUserVar=herdr_ssh={value}\x07")?;
+    writer.flush()
+}
+
