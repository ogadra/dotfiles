diff --git a/src/server/git_path.rs b/src/server/git_path.rs
new file mode 100644
index 00000000..c80c4642
--- /dev/null
+++ b/src/server/git_path.rs
@@ -0,0 +1,99 @@
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+/// How long a looked-up repository root is trusted. Snapshots are rebuilt on every render, so
+/// walking the filesystem each time would stat every ancestor per pane per frame; a short expiry
+/// still picks up a `git init` or a removed repository within seconds.
+const ROOT_CACHE_TTL: Duration = Duration::from_secs(5);
+
+type RootCache = HashMap<PathBuf, (Instant, Option<PathBuf>)>;
+
+/// Shows a directory relative to its git repository as `repo/sub/dir`, or with the home
+/// directory abbreviated to `~` outside a repository.
+pub(crate) fn display_path(cwd: &Path) -> String {
+    if let Some(root) = cached_repo_root(cwd) {
+        let name = root.file_name().map_or_else(
+            || root.display().to_string(),
+            |name| name.to_string_lossy().into_owned(),
+        );
+        return match cwd.strip_prefix(&root) {
+            Ok(rest) if !rest.as_os_str().is_empty() => format!("{name}/{}", rest.display()),
+            _ => name,
+        };
+    }
+    match std::env::var_os("HOME").map(PathBuf::from) {
+        Some(home) if cwd == home => "~".to_owned(),
+        Some(home) => cwd.strip_prefix(&home).map_or_else(
+            |_| cwd.display().to_string(),
+            |rest| format!("~/{}", rest.display()),
+        ),
+        None => cwd.display().to_string(),
+    }
+}
+
+fn cached_repo_root(cwd: &Path) -> Option<PathBuf> {
+    static CACHE: OnceLock<Mutex<RootCache>> = OnceLock::new();
+    let now = Instant::now();
+    let mut cache = CACHE.get_or_init(Default::default).lock().ok()?;
+    if let Some((checked, root)) = cache.get(cwd) {
+        if now.duration_since(*checked) < ROOT_CACHE_TTL {
+            return root.clone();
+        }
+    }
+    let root = repo_root(cwd);
+    cache.retain(|_, (checked, _)| now.duration_since(*checked) < ROOT_CACHE_TTL);
+    cache.insert(cwd.to_path_buf(), (now, root.clone()));
+    root
+}
+
+/// `.git` is a directory in a clone and a file in a linked worktree, so either marks the root.
+fn repo_root(cwd: &Path) -> Option<PathBuf> {
+    cwd.ancestors()
+        .find(|dir| dir.join(".git").exists())
+        .map(Path::to_path_buf)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn temp_root(name: &str) -> PathBuf {
+        let stamp = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .expect("clock should be after unix epoch")
+            .as_nanos();
+        std::env::temp_dir().join(format!(
+            "herdr-git-path-{name}-{}-{stamp}",
+            std::process::id()
+        ))
+    }
+
+    #[test]
+    fn shows_the_repository_name_and_the_path_below_it() {
+        let repo = temp_root("repo").join("dotfiles");
+        std::fs::create_dir_all(repo.join(".git")).unwrap();
+        std::fs::create_dir_all(repo.join("home/cli")).unwrap();
+
+        assert_eq!(display_path(&repo), "dotfiles");
+        assert_eq!(display_path(&repo.join("home/cli")), "dotfiles/home/cli");
+    }
+
+    #[test]
+    fn treats_a_git_file_as_a_linked_worktree_root() {
+        let worktree = temp_root("worktree").join("feature");
+        std::fs::create_dir_all(&worktree).unwrap();
+        std::fs::write(worktree.join(".git"), "gitdir: /elsewhere\n").unwrap();
+
+        assert_eq!(display_path(&worktree), "feature");
+    }
+
+    #[test]
+    fn falls_back_to_the_full_path_outside_a_repository() {
+        let plain = temp_root("plain").join("plain");
+        std::fs::create_dir_all(&plain).unwrap();
+
+        assert!(display_path(&plain).ends_with("plain"));
+    }
+}
