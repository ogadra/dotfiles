+
+/// A row with an agent keeps the round agent icon. One without reports no agent status, so it
+/// takes a square icon for its shells' command state instead; the shape tells the two kinds
+/// apart, and each state borrows the color of its agent counterpart.
+pub(super) fn status_or_activity_icon(
+    status: crate::api::schema::AgentStatus,
+    activity: crate::protocol::ClientShellTabActivity,
+    config: &ClientShellConfig,
+) -> (&'static str, ratatui::style::Color) {
+    use crate::api::schema::AgentStatus;
+    use crate::protocol::ClientShellTabActivity;
+
+    if status != AgentStatus::Unknown {
+        return (
+            status_icon(status, config.status_indicators),
+            status_color(status, &config.palette),
+        );
+    }
+    let (icon, status) = match activity {
+        ClientShellTabActivity::Running => ("■", AgentStatus::Working),
+        ClientShellTabActivity::Unread => ("■", AgentStatus::Done),
+        ClientShellTabActivity::Idle => ("□", AgentStatus::Idle),
+    };
+    (icon, status_color(status, &config.palette))
+}
