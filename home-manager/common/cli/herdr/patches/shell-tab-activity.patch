+/// Command state of the shells in a tab, tracked from their foreground process group rather
+/// than from agent detection, so it covers plain shells that report no agent status.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub enum ClientShellTabActivity {
+    /// Every shell is at its prompt and its last command was viewed.
+    #[default]
+    Idle,
+    /// A shell runs a command in the foreground.
+    Running,
+    /// A command finished while the tab was not viewed.
+    Unread,
+}
+
+impl ClientShellTabActivity {
+    /// Rank for showing several shells as one icon: a running command outranks an unread one,
+    /// which outranks an idle prompt.
+    pub fn priority(self) -> u8 {
+        match self {
+            Self::Running => 2,
+            Self::Unread => 1,
+            Self::Idle => 0,
+        }
+    }
 }
 
