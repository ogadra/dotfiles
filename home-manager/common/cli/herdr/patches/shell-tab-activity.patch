+#[test]
+fn tabs_without_an_agent_show_their_command_state_as_a_square() {
+    let mut state = sidebar_tabs_state(4, 1);
+    let mut projected = state.snapshot.as_deref().expect("snapshot").clone();
+    projected.tabs[0].agent_status = AgentStatus::Working;
+    projected.tabs[0].activity = crate::protocol::ClientShellTabActivity::Running;
+    for (tab, activity) in projected.tabs[1..].iter_mut().zip([
+        crate::protocol::ClientShellTabActivity::Running,
+        crate::protocol::ClientShellTabActivity::Unread,
+        crate::protocol::ClientShellTabActivity::Idle,
+    ]) {
+        tab.agent_status = AgentStatus::Unknown;
+        tab.activity = activity;
+    }
+    state.set_snapshot(Box::new(projected));
+    let frame = state.compose(106, 30).expect("sidebar tabs");
+    let layout = state.layout(106, 30);
+    let buffer = frame.to_ratatui_buffer().expect("sidebar tabs buffer");
+    let icon = |name: &str| {
+        let (column, row) = cell_symbol_position(&frame, layout.sidebar, name);
+        let cell = buffer.cell((column - 2, row)).expect("tab icon cell");
+        (cell.symbol().to_owned(), cell.fg)
+    };
+    let palette = &state.config.palette;
+
+    assert_eq!(icon("name1"), ("●".to_owned(), palette.yellow));
+    assert_eq!(icon("name2"), ("■".to_owned(), palette.yellow));
+    assert_eq!(icon("name3"), ("■".to_owned(), palette.teal));
+    assert_eq!(icon("name4"), ("□".to_owned(), palette.green));
+}
+
+#[test]
+fn a_space_without_an_agent_shows_the_command_state_its_tabs_most_need_attention_for() {
+    let mut state = sidebar_tabs_state(3, 1);
+    let mut projected = state.snapshot.as_deref().expect("snapshot").clone();
+    projected.workspaces[0].agent_status = AgentStatus::Unknown;
+    for (tab, activity) in projected.tabs.iter_mut().zip([
+        crate::protocol::ClientShellTabActivity::Idle,
+        crate::protocol::ClientShellTabActivity::Unread,
+        crate::protocol::ClientShellTabActivity::Idle,
+    ]) {
+        tab.agent_status = AgentStatus::Unknown;
+        tab.activity = activity;
+    }
+    state.set_snapshot(Box::new(projected.clone()));
+    let space_icon = |state: &mut ClientShellState| {
+        let frame = state.compose(106, 30).expect("sidebar tabs");
+        let layout = state.layout(106, 30);
+        let buffer = frame.to_ratatui_buffer().expect("sidebar tabs buffer");
+        let (column, row) = cell_symbol_position(&frame, layout.sidebar, "client-shell");
+        let cell = buffer.cell((column - 2, row)).expect("space icon cell");
+        (cell.symbol().to_owned(), cell.fg)
+    };
+    let palette = state.config.palette.clone();
+
+    assert_eq!(space_icon(&mut state), ("■".to_owned(), palette.teal));
+
+    projected.tabs[2].activity = crate::protocol::ClientShellTabActivity::Running;
+    state.set_snapshot(Box::new(projected.clone()));
+    assert_eq!(space_icon(&mut state), ("■".to_owned(), palette.yellow));
+
+    projected.workspaces[0].agent_status = AgentStatus::Done;
+    state.set_snapshot(Box::new(projected));
+    assert_eq!(space_icon(&mut state), ("●".to_owned(), palette.teal));
+}
