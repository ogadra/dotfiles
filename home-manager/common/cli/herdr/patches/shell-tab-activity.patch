+
+    /// Whether the pane's shell has handed the terminal to a command. The shell leads its own
+    /// process group, so any other foreground group is a job it runs; `pane_shell_is_idle` is
+    /// not used because it also counts the prompt's helpers, which stay in the shell's group.
+    pub fn foreground_command_running_for_pane(
+        &self,
+        pane_id: PaneId,
+        terminal_runtimes: &TerminalRuntimeRegistry,
+    ) -> bool {
+        let Some(shell_pid) = self
+            .terminal_id(pane_id)
+            .and_then(|terminal_id| terminal_runtimes.get(terminal_id))
+            .and_then(|rt| rt.child_pid())
+        else {
+            return false;
+        };
+        crate::detect::foreground_process_group_id(shell_pid)
+            .is_some_and(|group| group != shell_pid)
+    }
 }
