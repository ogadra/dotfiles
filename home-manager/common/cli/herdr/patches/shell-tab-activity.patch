index 0000000..5923b42
--- /dev/null
+++ b/src/server/shell_activity.rs
@@ -0,0 +1,146 @@
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+
+use crate::protocol::ClientShellTabActivity;
+use crate::terminal::TerminalId;
+
+/// What the last snapshot saw of a terminal's shell.
+#[derive(Debug, Clone, Copy, Default)]
+struct Observed {
+    running: bool,
+    unread: bool,
+}
+
+/// Per-terminal command history behind the sidebar's shell tab icons.
+#[derive(Debug, Default)]
+struct ShellActivity {
+    observed: HashMap<TerminalId, Observed>,
+}
+
+impl ShellActivity {
+    /// A command seen running and gone by a snapshot of a client that is not viewing the tab
+    /// leaves the terminal unread until a client views it or the shell starts another command.
+    fn observe(
+        &mut self,
+        terminal_id: &TerminalId,
+        running: bool,
+        viewed: bool,
+    ) -> ClientShellTabActivity {
+        let entry = self.observed.entry(terminal_id.clone()).or_default();
+        let finished = entry.running && !running;
+        entry.running = running;
+        entry.unread = !running && !viewed && (entry.unread || finished);
+        if running {
+            ClientShellTabActivity::Running
+        } else if entry.unread {
+            ClientShellTabActivity::Unread
+        } else {
+            ClientShellTabActivity::Idle
+        }
+    }
+
+    fn retain(&mut self, live: impl Fn(&TerminalId) -> bool) {
+        self.observed.retain(|terminal_id, _| live(terminal_id));
+    }
+}
+
+/// Snapshots are built from a shared `&App`, so the history lives here rather than on
+/// `TerminalState`, which every snapshot caller would then have to borrow mutably.
+fn shared() -> &'static Mutex<ShellActivity> {
+    static SHARED: OnceLock<Mutex<ShellActivity>> = OnceLock::new();
+    SHARED.get_or_init(Default::default)
+}
+
+/// Records whether the terminal's shell runs a command now and returns what its tab shows.
+pub(crate) fn observe(
+    terminal_id: &TerminalId,
+    running: bool,
+    viewed: bool,
+) -> ClientShellTabActivity {
+    match shared().lock() {
+        Ok(mut activity) => activity.observe(terminal_id, running, viewed),
+        Err(_) => ClientShellTabActivity::Idle,
+    }
+}
+
+/// Drops terminals that no longer exist, so closed panes do not accumulate.
+pub(crate) fn retain(live: impl Fn(&TerminalId) -> bool) {
+    if let Ok(mut activity) = shared().lock() {
+        activity.retain(live);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_command_that_finishes_unviewed_stays_unread_until_viewed() {
+        let mut activity = ShellActivity::default();
+        let terminal = TerminalId::alloc();
+
+        assert_eq!(
+            activity.observe(&terminal, true, false),
+            ClientShellTabActivity::Running
+        );
+        assert_eq!(
+            activity.observe(&terminal, false, false),
+            ClientShellTabActivity::Unread
+        );
+        assert_eq!(
+            activity.observe(&terminal, false, false),
+            ClientShellTabActivity::Unread
+        );
+        assert_eq!(
+            activity.observe(&terminal, false, true),
+            ClientShellTabActivity::Idle
+        );
+        assert_eq!(
+            activity.observe(&terminal, false, false),
+            ClientShellTabActivity::Idle
+        );
+    }
+
+    #[test]
+    fn a_command_that_finishes_while_viewed_is_read() {
+        let mut activity = ShellActivity::default();
+        let terminal = TerminalId::alloc();
+        activity.observe(&terminal, true, true);
+
+        assert_eq!(
+            activity.observe(&terminal, false, true),
+            ClientShellTabActivity::Idle
+        );
+        assert_eq!(
+            activity.observe(&terminal, false, false),
+            ClientShellTabActivity::Idle
+        );
+    }
+
+    #[test]
+    fn a_new_command_clears_the_unread_mark() {
+        let mut activity = ShellActivity::default();
+        let terminal = TerminalId::alloc();
+        activity.observe(&terminal, true, false);
+        activity.observe(&terminal, false, false);
+
+        assert_eq!(
+            activity.observe(&terminal, true, false),
+            ClientShellTabActivity::Running
+        );
+    }
+
+    #[test]
+    fn retain_forgets_closed_terminals() {
+        let mut activity = ShellActivity::default();
+        let closed = TerminalId::alloc();
+        activity.observe(&closed, true, false);
+
+        activity.retain(|terminal_id| terminal_id != &closed);
+
+        assert_eq!(
+            activity.observe(&closed, false, false),
+            ClientShellTabActivity::Idle
+        );
+    }
+}
