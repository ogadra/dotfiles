+#[test]
+fn rectangle_selection_copies_through_a_rectangle_read() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(snapshot()));
+    let mut pane_surface = surface();
+    pane_surface.panes[0].scroll = Some(crate::protocol::PaneSurfaceScrollMetrics {
+        offset_from_bottom: 0,
+        max_offset_from_bottom: 0,
+        viewport_rows: 2,
+    });
+    state.set_pane_surface(pane_surface);
+    state.compose(106, 20).expect("composed frame");
+    state.handle_input_bytes(b"\x02[");
+    let origin = state.copy_mode.as_ref().expect("copy mode").cursor;
+    assert!(origin.row > 0);
+
+    state.handle_input_bytes(b"\x0b");
+    state.handle_input_bytes(b"\x10");
+    state.handle_input_bytes(b"\x06");
+    let copied = state.handle_input_bytes(b"\x1bw");
+
+    assert!(copied.actions.iter().any(|action| matches!(
+        action,
+        ClientShellAction::Endpoint { request, .. }
+            if matches!(&request.method, crate::api::schema::Method::PaneSelectionRead(params)
+                if params.rectangle
+                    && params.anchor == crate::api::schema::PaneTextPoint {
+                        row: origin.row - 1,
+                        col: origin.col,
+                    }
+                    && params.cursor == crate::api::schema::PaneTextPoint {
+                        row: origin.row,
+                        col: origin.col + 1,
+                    })
+    )));
+    assert_eq!(state.mode, ClientShellMode::Terminal);
+}
