+#[test]
+fn selection_keys_switch_kind_around_the_same_anchor_and_toggle_off() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(snapshot()));
+    let mut pane_surface = surface();
+    pane_surface.panes[0].scroll = Some(crate::protocol::PaneSurfaceScrollMetrics {
+        offset_from_bottom: 0,
+        max_offset_from_bottom: 0,
+        viewport_rows: 2,
+    });
+    state.set_pane_surface(pane_surface);
+    state.compose(106, 20).expect("composed frame");
+    state.handle_input_bytes(b"\x02[");
+    let origin = state.copy_mode.as_ref().expect("copy mode").cursor;
+    let end_col = state.copy_mode.as_ref().expect("copy mode").geometry.0 - 1;
+
+    state.handle_input_bytes(b"\x00");
+    state.handle_input_bytes(b"\x10");
+    state.handle_input_bytes(b"\x06");
+    let cursor = state.copy_mode.as_ref().expect("copy mode").cursor;
+    assert_eq!(
+        state.copy_mode.as_ref().unwrap().selection,
+        Some(ClientCopySelection::Character(origin))
+    );
+
+    state.handle_input_bytes(b"\x0c");
+    assert_eq!(
+        state.copy_mode.as_ref().unwrap().selection,
+        Some(ClientCopySelection::Linewise(origin))
+    );
+    assert_eq!(
+        state.selection.as_ref().expect("linewise").ordered_cells(),
+        ((cursor.row, 0), (origin.row, end_col))
+    );
+
+    state.handle_input_bytes(b"\x0b");
+    assert_eq!(
+        state.copy_mode.as_ref().unwrap().selection,
+        Some(ClientCopySelection::Rectangle(origin))
+    );
+    let rectangle = state.selection.as_ref().expect("rectangle");
+    assert!(rectangle.is_rectangle());
+    assert_eq!(
+        rectangle.ordered_cells(),
+        (
+            (cursor.row, origin.col.min(cursor.col)),
+            (origin.row, origin.col.max(cursor.col))
+        )
+    );
+
+    state.handle_input_bytes(b"\x0b");
+    assert_eq!(state.copy_mode.as_ref().unwrap().selection, None);
+    assert!(state.selection.is_none());
+    assert_eq!(state.mode, ClientShellMode::Copy);
+}
