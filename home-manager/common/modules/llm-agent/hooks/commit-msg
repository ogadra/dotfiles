#!/usr/bin/env bash
# Reject a commit message with a body, since a change that needs prose should be several commits; trailers after the subject are fine.
set -u

if [ -z "${CO_AUTHOR:-}" ]; then
  printf 'Rejected: CO_AUTHOR is not set.\n' >&2
  exit 1
fi
grep -iv '^co-authored-by:' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
git interpret-trailers --in-place --trailer "Co-authored-by=$CO_AUTHOR" "$1"

GIT_DIR=$(git rev-parse --git-dir)
for STATE in MERGE_HEAD REVERT_HEAD CHERRY_PICK_HEAD; do
  # git writes a body of its own for these, so leave them alone.
  [ -e "$GIT_DIR/$STATE" ] && exit 0
done

TRAILER_RE='^[A-Za-z][A-Za-z0-9-]*: .'
SUBJECT_SEEN=0

while IFS= read -r LINE; do
  case "$LINE" in '#'*) continue ;; esac
  [ -n "$LINE" ] || continue
  if [ "$SUBJECT_SEEN" -eq 0 ]; then
    SUBJECT_SEEN=1
    continue
  fi
  [[ "$LINE" =~ $TRAILER_RE ]] && continue
  printf 'Rejected: the commit message has a body line: "%s".\n' "$LINE" >&2
  printf 'Keep the message to one subject line. When a change needs more, split it into several commits.\n' >&2
  exit 1
done < "$1"
exit 0
